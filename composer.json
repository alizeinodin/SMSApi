{
    "name": "alizeinodin/smsapi",
    "description": "Laravel SMS & messenger package for Iranian providers (sms.ir, Kavenegar, Ghasedak, Melipayamak, …) with failover, templates, OTP vault, and queues",
    "keywords": [
        "laravel",
        "sms",
        "otp",
        "notification",
        "failover",
        "iran",
        "sms.ir",
        "smsir",
        "kavenegar",
        "ghasedak",
        "melipayamak",
        "farazsms",
        "magfa",
        "ippanel",
        "niksms",
        "mediana",
        "avanak",
        "telegram",
        "whatsapp",
        "bale",
        "eitaa",
        "rubika",
        "driver"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ali Zeinodin",
            "email": "alizeinodin79@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.5",
        "illuminate/bus": "^10.0|^11.0|^12.0",
        "illuminate/cache": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/mail": "^10.0|^11.0|^12.0",
        "illuminate/notifications": "^10.0|^11.0|^12.0",
        "illuminate/queue": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "laravel/pint": "^1.32"
    },
    "suggest": {
        "phpunit/phpunit": "Required for Sms::fake() assertions in tests"
    },
    "autoload": {
        "psr-4": {
            "Alizeinodin\\SmsApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alizeinodin\\SmsApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Alizeinodin\\SmsApi\\SmsApiServiceProvider"
            ],
            "aliases": {
                "Sms": "Alizeinodin\\SmsApi\\Facades\\Sms"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
