{
    "name": "alizeinodin/smsapi",
    "description": "Laravel SMS package for Iranian panels (sms.ir, Kavenegar, Ghasedak, …) with sandbox integration tests",
    "keywords": ["laravel", "sms", "sms.ir", "kavenegar", "otp", "sandbox"],
    "license": "MIT",
    "authors": [
        {
            "name": "Ali Zeinodin",
            "email": "alizeinodin79@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^9.6|^10.0|^11.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "Alizeinodin\\SmsApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alizeinodin\\SmsApi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Alizeinodin\\SmsApi\\SmsApiServiceProvider"
            ],
            "aliases": {
                "Sms": "Alizeinodin\\SmsApi\\Facades\\Sms"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:sandbox": "phpunit --group sandbox"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
