# Shared recipient for live sandbox / test sends (your own number)
SMSAPI_SANDBOX_MOBILE=0912xxxxxxx

# ---------------------------------------------------------------------------
# sms.ir — official Sandbox API key (Developers → API keys → type: Sandbox)
# Verify uses fixed template 123456 with parameter "Code"
# ---------------------------------------------------------------------------
SMSAPI_API_KEY=
SMSAPI_LINE_NUMBER=
SMSAPI_BASE_URL=https://api.sms.ir/v1

